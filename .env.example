# Runtime
# Data root override; DATABASE_PATH and AGENT_WORKSPACE_ROOT resolve relative to it.
# Defaults to the repository root when running from source, and to ~/.fieldnote for `npx fieldnote`.
# FIELDNOTE_HOME=~/.fieldnote
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/agent.db
AGENT_WORKSPACE_ROOT=./data/workspaces
AGENT_RUNTIME=auto
# Leave these blank to inherit a working Claude CLI user configuration.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# Third-party Anthropic-compatible endpoint (DeepSeek, Kimi, GLM, a self-hosted gateway...).
# Set the token and base URL above, then map the aliases below onto models that provider
# actually serves. The mapping matters: chat uses the model saved in the web UI, but
# background work asks for aliases -- auto-titling and memory upkeep request `sonnet`, and
# subagents use CLAUDE_CODE_SUBAGENT_MODEL. Without the mapping, chat can look fine while
# titles and memory silently fail.
# ANTHROPIC_MODEL=<provider-model>
# ANTHROPIC_DEFAULT_SONNET_MODEL=<provider-model>
# ANTHROPIC_DEFAULT_SONNET_MODEL_NAME=<provider-model>
# ANTHROPIC_DEFAULT_HAIKU_MODEL=<provider-fast-model>
# ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME=<provider-fast-model>
# ANTHROPIC_DEFAULT_OPUS_MODEL=<provider-model>
# ANTHROPIC_DEFAULT_OPUS_MODEL_NAME=<provider-model>
# CLAUDE_CODE_SUBAGENT_MODEL=<provider-fast-model>
# auto inherits ~/.claude/settings.json when it contains Claude authentication.
# Set isolated for CI, deployment, or a runtime that must ignore personal plugins/MCP/settings.
CLAUDE_SETTINGS_MODE=auto
# Optional alternate Claude config directory (must contain settings.json).
CLAUDE_CONFIG_DIR=
AGENT_MODEL=sonnet
AGENT_MAX_CONCURRENCY=2
AGENT_MAX_TURNS=30
AGENT_RUN_TIMEOUT_MINUTES=20
AGENT_MAX_BUDGET_USD=2

# Feishu (leave empty to disable the channel)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_OPEN_IDS=
# URL opened by the Feishu card's “打开对话” button.
WEB_APP_URL=http://127.0.0.1:5173

# Development
LOG_LEVEL=info
